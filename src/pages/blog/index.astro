---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHead from "../../components/PageHead.astro";
import PostCard from "../../components/PostCard.astro";
import { sortByDateDesc, visiblePosts } from "../../lib/posts";

// Drafts are visible in `astro dev`, hidden in the production build.
const all = await getCollection("blog");
const posts = sortByDateDesc(visiblePosts(all, import.meta.env.DEV));
---

<BaseLayout
  title="Writing"
  description="Essays on software engineering, AI systems, and the craft — by Harish Krishnan."
>

  <!-- ── PAGE HEAD — GlyphField band behind Eyebrow + display h2 ────────── -->
  <PageHead eyebrow="The Writing">Notes on building software.</PageHead>

  <!-- ── BLOG BODY ─────────────────────────────────────────────────────────── -->
  <div class="wrap blog-body">
    <p class="lede reveal">
      Essays on architecture, AI systems, and the craft. Self-hosted, no
      tracking, no paywall.
    </p>
    <div class="rule"></div>

    {
      posts.length === 0 ? (
        <p class="empty reveal">No posts yet — first one is coming.</p>
      ) : (
        <div class="post-list">
          {posts.map((p) => (
            <PostCard
              id={p.id}
              title={p.data.title}
              description={p.data.description}
              date={p.data.date}
              tags={p.data.tags}
              draft={p.data.draft}
            />
          ))}
        </div>
      )
    }
  </div>

</BaseLayout>

<style>
  /* ── BLOG BODY ────────────────────────────────────────────────────────── */
  .blog-body {
    padding-block: clamp(48px, 7vw, 72px);
    border-top: 1px solid var(--line);
    max-width: var(--measure-wide);
  }
  .lede {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--dim);
    line-height: 1.7;
    max-width: 52ch;
    margin-bottom: 24px;
  }
  /* .rule is defined globally; provides the gradient accent line. */
  .post-list {
    margin-top: clamp(24px, 4vw, 40px);
  }
  .empty {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--dim);
    margin-top: clamp(24px, 4vw, 40px);
  }
</style>
