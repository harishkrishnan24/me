---
import BaseLayout from "../layouts/BaseLayout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import GlyphField from "../components/GlyphField.astro";
import { href } from "../lib/links";

interface Repo {
  name: string;
  url: string;
  description: string;
  tags: string[];
}
interface RepoGroup {
  label: string;
  repos: Repo[];
}

const repoGroups: RepoGroup[] = [
  {
    label: "Package Libraries",
    repos: [
      {
        name: "Prisma",
        url: "https://github.com/prisma/prisma",
        description: "ORM for Node.js and TypeScript.",
        tags: ["TypeScript", "ORM"],
      },
      {
        name: "Apollo Client",
        url: "https://github.com/apollographql/apollo-client",
        description: "GraphQL client for React and other frameworks.",
        tags: ["GraphQL", "React"],
      },
      {
        name: "Angular",
        url: "https://github.com/angular/angular",
        description:
          "A platform for building mobile and desktop web applications.",
        tags: ["TypeScript", "Framework"],
      },
      {
        name: "Qwik",
        url: "https://github.com/QwikDev/qwik",
        description:
          "A new web framework for building fast, optimized applications.",
        tags: ["TypeScript", "Framework"],
      },
    ],
  },
  {
    label: "Open Source Learning Sites",
    repos: [
      {
        name: "JavaScript.info",
        url: "https://javascript.info/",
        description: "Open source JavaScript tutorials and resources.",
        tags: ["JavaScript", "Docs"],
      },
      {
        name: "Zig Guide",
        url: "https://github.com/Sobeston/zig.guide",
        description:
          "Open source Zig programming language tutorials and resources.",
        tags: ["Zig", "Docs"],
      },
    ],
  },
  {
    label: "Developer Tools",
    repos: [
      {
        name: "Bulletproof React",
        url: "https://github.com/alan2207/bulletproof-react",
        description:
          "A collection of best practices for building React applications.",
        tags: ["React", "Best Practices"],
      },
    ],
  },
];

interface Contribution {
  project: string;
  type: string;
  contribution: string;
  status: string;
  url: string;
}

const contributions: Contribution[] = [
  {
    project: "JavaScript.info",
    type: "Documentation",
    contribution: "Fixed typo",
    status: "Merged",
    url: "https://github.com/javascript-tutorial/en.javascript.info/pull/3598",
  },
  {
    project: "prisma",
    type: "Bug",
    contribution: "Raised a bug",
    status: "Acknowledged",
    url: "https://github.com/prisma/prisma/issues/26021",
  },
  {
    project: "bulletproof-react",
    type: "Documentation",
    contribution: "Fixed typo",
    status: "Merged",
    url: "https://github.com/alan2207/bulletproof-react/pull/224",
  },
  {
    project: "apollo-client",
    type: "Documentation",
    contribution: "Fixed example error",
    status: "Merged",
    url: "https://github.com/apollographql/apollo-client/pull/11998",
  },
  {
    project: "angular",
    type: "Documentation",
    contribution: "Fixed typo",
    status: "Merged",
    url: "https://github.com/angular/angular/pull/56819",
  },
  {
    project: "angular",
    type: "Documentation",
    contribution: "Fixed typo",
    status: "Merged",
    url: "https://github.com/angular/angular/pull/56921",
  },
  {
    project: "angular",
    type: "Documentation",
    contribution: "Fixed typo",
    status: "Merged",
    url: "https://github.com/angular/angular/pull/56753",
  },
  {
    project: "qwik",
    type: "Documentation",
    contribution: "Fixed bug in links",
    status: "Merged",
    url: "https://github.com/QwikDev/qwik/pull/5445",
  },
  {
    project: "qwik",
    type: "Documentation",
    contribution: "Fixed typo",
    status: "Merged",
    url: "https://github.com/QwikDev/qwik/pull/5446",
  },
  {
    project: "qwik",
    type: "Documentation",
    contribution: "Fixed typo",
    status: "Merged",
    url: "https://github.com/QwikDev/qwik/pull/5444",
  },
  {
    project: "qwik",
    type: "Documentation",
    contribution: "Fixed typo",
    status: "Merged",
    url: "https://github.com/QwikDev/qwik/pull/4862",
  },
  {
    project: "qwik",
    type: "Documentation",
    contribution: "Fixed typo",
    status: "Merged",
    url: "https://github.com/QwikDev/qwik/pull/4885",
  },
  {
    project: "qwik",
    type: "Documentation",
    contribution: "Fixed typo",
    status: "Merged",
    url: "https://github.com/QwikDev/qwik/pull/4866",
  },
  {
    project: "qwik",
    type: "Documentation",
    contribution: "Fixed typo",
    status: "Merged",
    url: "https://github.com/QwikDev/qwik/pull/4861",
  },
  {
    project: "Zig Guide",
    type: "Documentation",
    contribution: "Fixed doc tests",
    status: "Closed",
    url: "https://github.com/Sobeston/zig.guide/pull/182",
  },
];
---

<BaseLayout
  title="Open Source"
  description="Open source contributions by Harish Krishnan — merged pull requests and repositories across Angular, Qwik, Prisma, Apollo Client, and more."
>

  <!-- ── PAGE HEAD — GlyphField band behind Eyebrow + display h2 ────────── -->
  <div class="page-head">
    <div class="page-head-bg" aria-hidden="true">
      <GlyphField density={26} interactive={false} height="200px" />
    </div>
    <div class="page-head-content wrap">
      <Eyebrow>Open Source</Eyebrow>
      <h2 class="page-title">Giving back to the community.</h2>
    </div>
  </div>

  <!-- ── INTRO ─────────────────────────────────────────────────────────────── -->
  <section class="wrap section-intro">
    <p class="intro-deck reveal">
      Open source software has been instrumental in my growth as a developer. I
      believe in giving back to the community that has given me so much — here
      are my contributions across the projects I rely on every day.
    </p>
  </section>

  <!-- ── REPOSITORIES — hairline link rows ────────────────────────────────── -->
  <section class="wrap section-repos">
    <header class="section-header reveal">
      <Eyebrow>Repositories</Eyebrow>
      <h2>Projects I've contributed to</h2>
    </header>
    {
      repoGroups.map((group) => (
        <div class="repo-group reveal">
          <h3 class="group-label">{group.label}</h3>
          <div class="repo-rows">
            {group.repos.map((repo) => (
              <a
                class="repo-row"
                href={repo.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                <div class="repo-row-inner">
                  <div class="repo-row-body">
                    <span class="repo-row-name">{repo.name}</span>
                    <p class="repo-row-desc">{repo.description}</p>
                    <div class="tag-row repo-row-tags">
                      {repo.tags.map((t) => (
                        <span class="tag">{t}</span>
                      ))}
                    </div>
                  </div>
                  <span class="repo-row-cta">View on GitHub →</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))
    }
  </section>

  <!-- ── CONTRIBUTIONS — table ─────────────────────────────────────────────── -->
  <section class="wrap section-contributions">
    <header class="section-header reveal">
      <Eyebrow>Contributions</Eyebrow>
      <h2>Merged &amp; accepted work</h2>
    </header>
    <div class="table-wrap reveal">
      <table>
        <thead>
          <tr>
            <th>Project</th>
            <th>Type</th>
            <th>Contribution</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {
            contributions.map((c) => (
              <tr>
                <td class="td-project">{c.project}</td>
                <td>{c.type}</td>
                <td>{c.contribution}</td>
                <td>
                  <a
                    class="status-link"
                    href={c.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {c.status} →
                  </a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <!-- ── COLLABORATE ───────────────────────────────────────────────────────── -->
  <section class="wrap section-collaborate">
    <header class="section-header reveal">
      <Eyebrow>Collaborate</Eyebrow>
      <h2>Want to build something?</h2>
    </header>
    <p class="collab-blurb reveal">
      I'm always looking for interesting projects to contribute to and
      passionate developers to collaborate with. Whether you need help with a
      project, want to pair program, or have an idea for a new open source
      initiative, let's connect.
    </p>
    <div class="cta-row reveal">
      <a
        class="btn"
        href="https://github.com/harishkrishnan24"
        target="_blank"
        rel="noopener noreferrer">See my GitHub →</a
      >
      <a class="btn btn-ghost" href={href("about")}>Get in touch</a>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── PAGE HEAD ─────────────────────────────────────────────────────────── */
  .page-head {
    position: relative;
    height: 200px;
    overflow: hidden;
  }
  .page-head-bg {
    position: absolute;
    inset: 0;
  }
  .page-head-content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-block: clamp(24px, 4vw, 40px);
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--bg) 82%, transparent) 0%,
      color-mix(in srgb, var(--bg) 82%, transparent) 55%,
      transparent 100%
    );
  }
  @media (max-width: 860px) {
    .page-head-content {
      background: color-mix(in srgb, var(--bg) 88%, transparent);
    }
  }
  .page-title {
    font-family: var(--font-display);
    font-size: clamp(34px, 5.4vw, 80px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
    max-width: 20ch;
    margin-top: 10px;
  }

  /* ── SHARED SECTION ─────────────────────────────────────────────────────── */
  .section-intro,
  .section-repos,
  .section-contributions,
  .section-collaborate {
    padding-block: clamp(48px, 7vw, 72px);
    border-top: 1px solid var(--line);
  }
  .section-header {
    margin-bottom: clamp(24px, 4vw, 40px);
  }
  .section-header h2 {
    font-size: var(--step-2);
    margin-top: 10px;
  }

  /* ── INTRO ────────────────────────────────────────────────────────────── */
  .intro-deck {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--dim);
    line-height: 1.7;
    max-width: 60ch;
  }

  /* ── REPO ROWS ───────────────────────────────────────────────────────── */
  .repo-group {
    margin-bottom: clamp(32px, 5vw, 48px);
  }
  .repo-group:last-child {
    margin-bottom: 0;
  }
  .group-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
    margin-bottom: 12px;
  }
  .repo-rows {
    border-top: 1px solid var(--line);
  }
  .repo-row {
    display: block;
    border-bottom: 1px solid var(--line);
    transition: border-color 0.15s var(--ease);
    color: var(--fg);
  }
  .repo-row:hover {
    border-bottom-color: var(--accent);
  }
  .repo-row-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    padding: clamp(16px, 2.5vw, 24px) 0;
  }
  .repo-row-body {
    flex: 1;
    min-width: 0;
  }
  .repo-row-name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 400;
    color: var(--fg);
    display: block;
    margin-bottom: 6px;
    transition: color 0.15s var(--ease);
  }
  .repo-row:hover .repo-row-name {
    color: var(--accent);
  }
  .repo-row-desc {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--dim);
    line-height: 1.6;
    margin-bottom: 10px;
    max-width: 52ch;
  }
  .repo-row-tags {
    /* uses global .tag-row */
  }
  .repo-row-cta {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    white-space: nowrap;
    flex-shrink: 0;
    padding-top: 4px;
    transition: opacity 0.15s var(--ease);
  }
  .repo-row:hover .repo-row-cta {
    opacity: 0.7;
  }
  @media (max-width: 600px) {
    .repo-row-inner {
      flex-direction: column;
      gap: 12px;
    }
  }

  /* ── CONTRIBUTIONS TABLE ─────────────────────────────────────────────── */
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
  }
  .table-wrap table {
    margin-block: 0;
    min-width: 560px;
  }
  .table-wrap th,
  .table-wrap td {
    padding-inline: 18px;
  }
  .td-project {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--fg);
  }
  .status-link {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--accent);
    white-space: nowrap;
    transition: opacity 0.15s var(--ease);
  }
  .status-link:hover {
    opacity: 0.7;
  }

  /* ── COLLABORATE ─────────────────────────────────────────────────────── */
  .collab-blurb {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--dim);
    line-height: 1.6;
    max-width: 52ch;
    margin-bottom: 28px;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .btn-ghost {
    background: transparent;
    color: var(--dim);
    border-color: var(--line);
  }
  .btn-ghost:hover {
    color: var(--fg);
    border-color: var(--dim);
  }
</style>
