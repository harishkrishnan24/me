---
import BaseLayout from "../layouts/BaseLayout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import PageHead from "../components/PageHead.astro";
import { href } from "../lib/links";

interface Book {
  title: string;
  author: string;
  cover: string;
}

const reading: Book[] = [
  { title: "Designing Distributed Systems", author: "Unmesh Joshi", cover: "patterns-distributed-systems.png" },
  { title: "Domain-Driven Design", author: "Eric Evans", cover: "domain-driven-design.png" },
  { title: "Introduction to Algorithms", author: "Cormen, Leiserson, Rivest, Stein", cover: "intro-to-algorithms.png" },
];

const read: Book[] = [
  { title: "Designing Data-Intensive Applications", author: "Martin Kleppmann", cover: "ddia.png" },
  { title: "Clean Architecture", author: "Robert C. Martin", cover: "clean-architecture.png" },
  { title: "Microservices Patterns", author: "Chris Richardson", cover: "microservices-patterns.png" },
  { title: "Grokking Streaming Systems", author: "Josh Fischer & Ning Wang", cover: "grokking-streaming.png" },
  { title: "Programming Rust", author: "Jim Blandy & Jason Orendorff", cover: "programming-rust.png" },
  { title: "Mastering Go", author: "Mihalis Tsoukalos", cover: "mastering-go.png" },
  { title: "Clean Code", author: "Robert C. Martin", cover: "clean-code.png" },
  { title: "You Don't Know JS (Series)", author: "Kyle Simpson", cover: "ydkjs.png" },
  { title: "Advanced React", author: "Nadia Makarevich", cover: "advanced-react.png" },
];
---

<BaseLayout
  title="Bookshelf"
  description="A curated library of books and papers that have shaped how I think about software, systems, and the craft."
>

  <!-- ── PAGE HEAD — GlyphField band behind Eyebrow + display h2 ────────── -->
  <PageHead eyebrow="Bookshelf · Papers">My digital library.</PageHead>

  <!-- ── INTRO ─────────────────────────────────────────────────────────────── -->
  <section class="wrap section-intro">
    <p class="intro-deck reveal">
      Knowledge is the foundation of innovation. A curated collection of books
      and papers that have shaped my understanding of technology and software —
      and continue to guide the work.
    </p>
  </section>

  <!-- ── CURRENTLY READING ─────────────────────────────────────────────────── -->
  <section class="wrap section-shelf">
    <header class="section-header reveal">
      <Eyebrow>Currently reading</Eyebrow>
      <h2>On the nightstand</h2>
    </header>
    <ul class="book-grid reveal">
      {
        reading.map((book) => (
          <li class="book">
            <img
              class="book-cover"
              src={href(`images/books/${book.cover}`)}
              alt={`Cover of ${book.title}`}
              loading="lazy"
              decoding="async"
            />
            <h3 class="book-title">{book.title}</h3>
            <p class="book-author">{book.author}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ── READ ──────────────────────────────────────────────────────────────── -->
  <section class="wrap section-shelf">
    <header class="section-header reveal">
      <Eyebrow>Read</Eyebrow>
      <h2>Finished, and worth it</h2>
    </header>
    <ul class="book-grid reveal">
      {
        read.map((book) => (
          <li class="book">
            <img
              class="book-cover"
              src={href(`images/books/${book.cover}`)}
              alt={`Cover of ${book.title}`}
              loading="lazy"
              decoding="async"
            />
            <h3 class="book-title">{book.title}</h3>
            <p class="book-author">{book.author}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ── PAPERS ────────────────────────────────────────────────────────────── -->
  <section class="wrap section-shelf">
    <header class="section-header reveal">
      <Eyebrow>Papers</Eyebrow>
      <h2>Research &amp; whitepapers</h2>
    </header>
    <ul class="paper-list reveal">
      <li>
        <a
          href="https://web.stanford.edu/class/cs114/reading-keshav.pdf"
          target="_blank"
          rel="noopener noreferrer">How to Read a Paper</a
        >
        <span class="paper-author">S. Keshav</span>
      </li>
    </ul>
  </section>

</BaseLayout>

<style>
  /* ── SHARED SECTION ─────────────────────────────────────────────────────── */
  .section-intro,
  .section-shelf {
    padding-block: clamp(48px, 7vw, 72px);
    border-top: 1px solid var(--line);
  }

  /* ── INTRO ────────────────────────────────────────────────────────────── */
  /* max-width override over the global .intro-deck base */
  .intro-deck {
    max-width: 58ch;
  }

  /* ── BOOK GRID — hairline grid, no radius ────────────────────────────── */
  .book-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    border: 1px solid var(--line);
    gap: 1px;
    background: var(--line);
  }
  .book {
    background: var(--bg);
    padding: clamp(14px, 2vw, 20px);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .book-cover {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: 0;
    border: 1px solid var(--line);
    background: var(--panel);
    transition: border-color 0.25s var(--ease);
  }
  .book:hover .book-cover {
    border-color: var(--accent);
  }
  .book-title {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    font-weight: 400;
    line-height: 1.4;
    color: var(--fg);
  }
  .book-author {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.04em;
    color: var(--dim);
    line-height: 1.4;
  }
  @media (max-width: 480px) {
    .book-grid {
      grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    }
  }

  /* ── PAPERS ──────────────────────────────────────────────────────────── */
  .paper-list {
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .paper-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 12px;
    padding-block: 14px;
    border-bottom: 1px solid var(--line);
  }
  .paper-list a {
    color: var(--fg);
    border-bottom: 1px solid var(--line-strong);
    transition: border-color 0.15s var(--ease), color 0.15s var(--ease);
  }
  .paper-list a:hover {
    border-bottom-color: var(--accent);
    color: var(--accent);
  }
  .paper-author {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--dim);
  }
</style>
