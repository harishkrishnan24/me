---
import BaseLayout from "../layouts/BaseLayout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import GlyphField from "../components/GlyphField.astro";
import { href } from "../lib/links";

const languages = ["JavaScript / TypeScript", "Python", "Go", "Rust"];

interface Tech {
  label: string;
  learning?: boolean;
}
const tech: Tech[] = [
  { label: "React" },
  { label: "Angular" },
  { label: "Vue.js" },
  { label: "Svelte", learning: true },
  { label: "Node.js" },
  { label: "Express" },
  { label: "NestJS" },
  { label: "React Native", learning: true },
  { label: "Docker" },
  { label: "Kubernetes" },
  { label: "AWS" },
  { label: "MongoDB" },
  { label: "PostgreSQL" },
  { label: "GraphQL", learning: true },
  { label: "gRPC", learning: true },
  { label: "Cypress" },
  { label: "Protractor" },
  { label: "Jest" },
  { label: "Vitest" },
  { label: "React Testing Library" },
  { label: "Redux" },
  { label: "NgRx" },
  { label: "VueX" },
  { label: "AWS SageMaker", learning: true },
  { label: "Crew AI", learning: true },
  { label: "LangGraph", learning: true },
  { label: "LangChain", learning: true },
  { label: "MCP", learning: true },
];

interface Job {
  title: string;
  company: string;
  duration: string;
  location: string;
  description: string;
  technologies: string[];
  bullets: string[];
}

const jobs: Job[] = [
  {
    title: "Software Engineer",
    company: "DigitalRoute",
    duration: "Current Position",
    location: "Stockholm, Sweden",
    description: "Currently working on building robust Usage Data solutions.",
    technologies: [
      "React",
      "Node.js",
      "Express.js",
      "JavaScript",
      "TypeScript",
      "HTML",
      "CSS",
      "StoryBook",
      "Redux",
      "AWS Services",
      "AWS SageMaker",
      "Jest",
      "Vitest",
      "React Testing Library",
      "Playwright",
    ],
    bullets: [
      "Building scalable web applications using modern technologies such as React and Node.js",
      "Integrating AI/ML and LLM solutions",
    ],
  },
  {
    title: "Course Instructor (during my free time)",
    company: "Udemy",
    duration: "June 2023 — Present",
    location: "Remote",
    description:
      "Creating courses on the Udemy platform, focusing on software development, programming languages, and modern web technologies.",
    technologies: ["JavaScript", "TypeScript", "React", "Node.js", "Go", "Rust"],
    bullets: [
      "Created six courses with over a thousand students enrolled",
      "Maintain a rating of 4+ out of five across more than 50 reviews",
    ],
  },
  {
    title: "Software Engineer",
    company: "SAP Labs",
    duration: "Nov 2020 — Jan 2024",
    location: "Bengaluru, India",
    description:
      "Worked on enterprise software solutions, contributing to large-scale applications used by businesses worldwide using Angular, React, Node.js, Spring Boot, and more.",
    technologies: [
      "Angular",
      "React",
      "Node.js",
      "Spring Boot",
      "Java",
      "TypeScript",
      "JavaScript",
      "HTML",
      "CSS",
      "SAPUI5",
      "SAP CAP",
      "SAP BTP",
      "Jenkins",
      "Go",
      "Protractor",
      "DevOps",
      "Security",
    ],
    bullets: [
      "Developed enterprise-grade software applications for Real Estate and Human Resource",
      "Awarded three times for effective contribution to the team",
    ],
  },
  {
    title: "Front-end Developer",
    company: "Fragma Data Systems",
    duration: "Jul 2020 — Nov 2020",
    location: "Remote",
    description:
      "Contributed to UI development of multiple projects, for a bank called Mashreq in the UAE and a state government project.",
    technologies: [
      "React",
      "JavaScript",
      "TypeScript",
      "CSS",
      "HTML",
      "Redux",
      "Jest",
      "React Testing Library",
    ],
    bullets: ["Developed UI solutions using React and its ecosystem"],
  },
  {
    title: "Full Stack Developer",
    company: "FoodDocs (Contractor)",
    duration: "May 2017 — Mar 2020",
    location: "Remote",
    description: "Worked on building a food safety management system.",
    technologies: [
      "Angular",
      "Vue.js",
      "Laravel",
      "MySQL",
      "Cypress",
      "Flutter",
      "HTML",
      "CSS",
      "Bootstrap",
    ],
    bullets: [
      "Used Angular, Vue.js, Laravel, MySQL, Cypress, and Flutter to develop applications",
    ],
  },
  {
    title: "Software Engineer",
    company: "Boeing",
    duration: "Dec 2018 — May 2019",
    location: "Bengaluru, India",
    description:
      "Worked on developing software solutions for aerospace applications.",
    technologies: [
      "Angular",
      "Java",
      "Spring Boot",
      "TypeScript",
      "HTML",
      "CSS",
      "NgRx Store",
    ],
    bullets: [
      "Used Angular to develop a dashboard creation application",
      "Used Java / Spring Boot to develop backend services",
    ],
  },
  {
    title: "Freelance Developer",
    company: "Upwork",
    duration: "May 2017 — Dec 2018",
    location: "Remote",
    description:
      "Worked as a freelance developer on a real estate project, focusing on UI development and client collaboration to deliver high-quality web applications.",
    technologies: [
      "Angular",
      "TypeScript",
      "JavaScript",
      "HTML",
      "CSS",
      "NgRx Store",
    ],
    bullets: [
      "Actively contributed to UI development using Angular — building reusable components, setting up projects from scratch, and more",
      "Worked hand-in-hand with the owner of the idea to improve the product UI flow",
      "Involved in the recruitment of new people",
      "Communicated with the back-end developer, providing suggestions and integrating the UI with the back-end",
    ],
  },
  {
    title: "Software Engineer",
    company: "Squash Apps",
    duration: "Sep 2016 — May 2017",
    location: "Coimbatore, India",
    description:
      "Started as an entry-level software engineer and quickly developed full-stack development skills, contributing to in-house products and client projects.",
    technologies: [
      "MongoDB",
      "Express.js",
      "React",
      "Node.js (MERN Stack)",
      "Ionic",
    ],
    bullets: [
      "Joined as an entry-level software engineer",
      "Quickly ramped up with MERN stack skills within a month",
      "Actively contributed to in-house products, leading to an opportunity to work with US-based clients",
    ],
  },
];

const interests = [
  "Reading technical books and research papers across a range of topics",
  "Rust & Go programming languages",
  "Experimenting with new technologies",
  "Technical writing and blogging",
  "Building side projects and prototypes",
  "Contributing to open-source projects",
  "Formula One",
];
---

<BaseLayout
  title="About"
  description="Harish Krishnan — software engineer based in Stockholm. Background, skills, work experience, and the craft."
>

  <!-- ── PAGE HEAD — GlyphField band behind Eyebrow + display h2 ────────── -->
  <div class="page-head">
    <div class="page-head-bg" aria-hidden="true">
      <GlyphField density={26} interactive={false} height="200px" />
    </div>
    <div class="page-head-content wrap">
      <Eyebrow>About · Software Engineer · Stockholm</Eyebrow>
      <h2 class="page-title">A perpetual student of the craft.</h2>
    </div>
  </div>

  <!-- ── BACKGROUND — two-column: prose + spec table ───────────────────── -->
  <section class="wrap section-intro">
    <div class="intro-grid reveal">
      <div class="intro-prose">
        <Eyebrow>Background</Eyebrow>
        <p class="intro-deck">
          Software engineer based in Stockholm with experience across startups and
          enterprise. I build applications, teach, and write — and I'm always
          learning what comes next.
        </p>
        <div class="prose">
          <p>
            I'm Harish Krishnan, a software engineer based in Stockholm with
            experience in both startups and enterprise environments. I've built
            software applications using a wide range of technologies, and I actively
            share my knowledge through Udemy courses and technical writing.
            Previously, I've worked with companies like SAP, Boeing, and Siemens, and
            also as a contractor at companies like FoodDocs in Tallinn.
          </p>
          <p>
            Currently, I'm focused on deepening my expertise in Generative AI,
            Machine Learning, and distributed systems, while strengthening my
            fundamentals in software engineering. I'm also actively learning Go and
            Rust to build efficient, scalable systems. I'm passionate about
            continuous learning, with a strong interest in applying emerging
            technologies to solve real-world problems.
          </p>
        </div>
      </div>
      <table class="spec-table" aria-label="At a glance">
        <tbody>
          <tr>
            <th scope="row">ROLE</th>
            <td>Software Engineer</td>
          </tr>
          <tr>
            <th scope="row">ALSO</th>
            <td>Course instructor · writer</td>
          </tr>
          <tr>
            <th scope="row">FOCUS</th>
            <td>AI systems · distributed systems</td>
          </tr>
          <tr>
            <th scope="row">LEARNING</th>
            <td>Go · Rust</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ── TOOLBOX — chips ───────────────────────────────────────────────── -->
  <section class="wrap section-toolbox">
    <header class="section-header reveal">
      <Eyebrow>Technical skills</Eyebrow>
      <h2>What I work with</h2>
    </header>
    <div class="toolbox-group reveal">
      <h3 class="toolbox-label">Languages</h3>
      <div class="tag-row">
        {languages.map((l) => <span class="tag">{l}</span>)}
      </div>
    </div>
    <div class="toolbox-group reveal">
      <div class="toolbox-group-head">
        <h3 class="toolbox-label">Technologies & frameworks</h3>
        <span class="learning-legend">
          <span class="learning-dot" aria-hidden="true"></span> currently learning
        </span>
      </div>
      <div class="tag-row">
        {
          tech.map((t) => (
            <span class:list={["tag", { "tag-learning": t.learning }]}>
              {t.label}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── CERTIFICATIONS ───────────────────────────────────────────────── -->
  <section class="wrap section-certs">
    <header class="section-header reveal">
      <Eyebrow>Certifications</Eyebrow>
      <h2>Verified credentials</h2>
    </header>
    <div class="cert-cell reveal">
      <p class="cert-note">
        My professional certifications are issued and verified on Credly.
      </p>
      <a
        class="btn"
        href="https://www.credly.com/users/harish-krishnan.623b2d03"
        target="_blank"
        rel="noopener noreferrer">View my badges on Credly →</a
      >
    </div>
  </section>

  <!-- ── TRACK RECORD — hairline link rows ────────────────────────────── -->
  <section class="wrap section-track">
    <header class="section-header reveal">
      <Eyebrow>Work experience</Eyebrow>
      <h2>Where I've worked</h2>
    </header>
    <div class="track-list">
      {
        jobs.map((job) => (
          <article class="job-row reveal">
            <header class="job-row-head">
              <h3 class="job-title">{job.title}</h3>
              <p class="job-meta">
                {job.company} · {job.duration} · {job.location}
              </p>
            </header>
            <p class="job-desc">{job.description}</p>
            <ul class="job-bullets">
              {job.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
            <div class="tag-row job-tags">
              {job.technologies.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ── HOW I WORK — hairline grid of interests ───────────────────────── -->
  <section class="wrap section-interests">
    <header class="section-header reveal">
      <Eyebrow>Interests & hobbies</Eyebrow>
      <h2>Away from the keyboard (mostly)</h2>
    </header>
    <div class="interests-grid reveal">
      {
        interests.map((i) => (
          <div class="interest-cell">
            <p>{i}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ── EDUCATION ─────────────────────────────────────────────────────── -->
  <section class="wrap section-edu">
    <header class="section-header reveal">
      <Eyebrow>Education & learning</Eyebrow>
      <h2>A learning-first mindset</h2>
    </header>
    <div class="prose reveal">
      <p>
        I believe in continuous learning and staying current with the latest
        trends in technology. My educational journey includes a formal Bachelor
        of Engineering in Automobile Engineering, complemented by self-directed
        learning through online platforms, books, and hands-on projects in
        software development and engineering principles.
      </p>
      <p>
        I'm also passionate about sharing knowledge, which is why I create
        content on
        <a
          href="https://harishkrishnan1993.medium.com/"
          target="_blank"
          rel="noopener noreferrer">Medium</a
        >
        and develop courses on
        <a
          href="https://www.udemy.com/user/harish-krishnan-5/"
          target="_blank"
          rel="noopener noreferrer">Udemy</a
        >.
      </p>
    </div>
  </section>

  <!-- ── PHILOSOPHY ────────────────────────────────────────────────────── -->
  <section class="wrap section-philosophy reveal">
    <Eyebrow>Philosophy</Eyebrow>
    <blockquote class="philosophy-quote">
      With enough time, effort, and curiosity, any skill can be mastered and
      applied effectively.
    </blockquote>
  </section>

  <!-- ── CONNECT ───────────────────────────────────────────────────────── -->
  <section class="wrap section-connect">
    <header class="section-header reveal">
      <Eyebrow>Let's connect</Eyebrow>
      <h2>Always up for a good conversation</h2>
    </header>
    <div class="prose reveal">
      <p>
        I'm always open to interesting conversations about technology,
        collaboration opportunities, or simply connecting with fellow
        developers. Feel free to reach out through any of the platforms linked on
        the home page.
      </p>
      <p>
        Whether you're looking for technical insights, want to discuss a project,
        or just want to chat about the latest in software development, I'd love
        to hear from you.
      </p>
    </div>
    <div class="cta-row reveal">
      <a class="btn" href={href("")}>Get in touch →</a>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── PAGE HEAD ─────────────────────────────────────────────────────────── */
  .page-head {
    position: relative;
    height: 200px;
    overflow: hidden;
  }
  .page-head-bg {
    position: absolute;
    inset: 0;
  }
  /* Scrim: horizontal gradient so text reads clearly over glyphs.
     Mirrors the hero pattern in index.astro. */
  .page-head-content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-block: clamp(24px, 4vw, 40px);
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--bg) 82%, transparent) 0%,
      color-mix(in srgb, var(--bg) 82%, transparent) 55%,
      transparent 100%
    );
  }
  @media (max-width: 860px) {
    .page-head-content {
      background: color-mix(in srgb, var(--bg) 88%, transparent);
    }
  }
  .page-title {
    font-family: var(--font-display);
    font-size: clamp(34px, 5.4vw, 80px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
    max-width: 20ch;
    margin-top: 10px;
  }

  /* ── SECTION SHARED ─────────────────────────────────────────────────────── */
  .section-intro,
  .section-toolbox,
  .section-certs,
  .section-track,
  .section-interests,
  .section-edu,
  .section-philosophy,
  .section-connect {
    padding-block: clamp(48px, 7vw, 72px);
    border-top: 1px solid var(--line);
  }
  .section-header {
    margin-bottom: clamp(24px, 4vw, 40px);
  }
  .section-header h2 {
    font-size: var(--step-2);
    margin-top: 10px;
  }

  /* ── BACKGROUND / INTRO ─────────────────────────────────────────────────── */
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr minmax(200px, 280px);
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }
  .intro-prose .eyebrow {
    display: inline-block;
    margin-bottom: 16px;
  }
  .intro-deck {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--dim);
    line-height: 1.7;
    max-width: 44ch;
    margin-bottom: 20px;
  }
  @media (max-width: 720px) {
    .intro-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Spec table — overrides global table defaults within this page. */
  .spec-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
    margin-block: 0;
  }
  .spec-table tr {
    border-bottom: 1px solid var(--line);
  }
  .spec-table tr:last-child {
    border-bottom: none;
  }
  .spec-table th {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    text-align: left;
    padding: 10px 16px 10px 0;
    width: 88px;
    vertical-align: top;
    white-space: nowrap;
    border-bottom: none;
  }
  .spec-table td {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--fg);
    padding: 10px 0;
    line-height: 1.5;
    vertical-align: top;
    border-bottom: none;
  }

  /* ── TOOLBOX ────────────────────────────────────────────────────────────── */
  .toolbox-group {
    margin-bottom: clamp(20px, 3vw, 28px);
  }
  .toolbox-group:last-child {
    margin-bottom: 0;
  }
  .toolbox-group-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 14px;
  }
  .toolbox-label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 400;
    color: var(--fg);
    margin-bottom: 14px;
  }
  .toolbox-group-head .toolbox-label {
    margin-bottom: 0;
  }
  .learning-legend {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .learning-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }
  /* "currently learning" chips */
  .tag-learning {
    border-color: var(--accent);
    color: var(--accent);
  }
  .tag-learning::before {
    content: "";
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    margin-right: 6px;
    vertical-align: middle;
  }

  /* ── CERTIFICATIONS ─────────────────────────────────────────────────────── */
  .cert-cell {
    border: 1px solid var(--line);
    padding: clamp(20px, 3vw, 30px);
    display: grid;
    gap: 18px;
    justify-items: start;
    max-width: 520px;
  }
  .cert-note {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--dim);
    line-height: 1.6;
  }

  /* ── TRACK RECORD — hairline rows ───────────────────────────────────────── */
  .track-list {
    border-top: 1px solid var(--line);
  }
  .job-row {
    border-bottom: 1px solid var(--line);
    padding-block: clamp(20px, 3vw, 32px);
  }
  .job-row-head {
    margin-bottom: 12px;
  }
  .job-title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 400;
    color: var(--fg);
  }
  .job-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--dim);
    margin-top: 4px;
  }
  .job-desc {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--dim);
    line-height: 1.6;
    margin-bottom: 12px;
    max-width: 60ch;
  }
  .job-bullets {
    list-style: none;
    display: grid;
    gap: 8px;
    margin-bottom: 16px;
  }
  .job-bullets li {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--fg);
    padding-left: 18px;
    position: relative;
    line-height: 1.55;
  }
  .job-bullets li::before {
    content: "▹";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-size: 0.85em;
  }
  .job-tags {
    margin-top: 4px;
  }

  /* ── HOW I WORK — interests hairline grid ───────────────────────────────── */
  .interests-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    border: 1px solid var(--line);
    gap: 1px;
    background: var(--line);
  }
  .interest-cell {
    background: var(--bg);
    padding: clamp(20px, 3vw, 28px);
  }
  .interest-cell p {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--fg);
    line-height: 1.6;
  }

  /* ── PHILOSOPHY ──────────────────────────────────────────────────────────── */
  .philosophy-quote {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 400;
    line-height: 1.35;
    color: var(--fg);
    border-left: 3px solid var(--accent);
    padding: 8px 0 8px 26px;
    margin-top: 18px;
    max-width: 24em;
    text-wrap: balance;
  }

  /* ── CONNECT ─────────────────────────────────────────────────────────────── */
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }
</style>
