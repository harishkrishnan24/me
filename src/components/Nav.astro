---
import { navLinks, href, isActive } from "../lib/links";
const pathname = Astro.url.pathname;
---

<header class="site-header">
  <nav class="nav" aria-label="Primary">
    <a class="brand" href={href("")}>Harish Krishnan</a>
    <!-- CSS-only no-JS fallback: <details>/<summary> works without JS.
         On JS-enabled visitors the toggle button (.nav-toggle) is shown instead
         and the details element is kept in sync. On mobile with JS disabled,
         the summary acts as the toggle via native browser disclosure behaviour. -->
    <details class="nav-details">
      <summary class="nav-toggle" aria-label="Toggle navigation">
        <span></span><span></span>
      </summary>
      <ul class="nav-links">
        {
          navLinks.map((link) =>
            link.external ? (
              <li>
                <a href={link.path} target="_blank" rel="noopener noreferrer">
                  {link.label}
                </a>
              </li>
            ) : (
              <li>
                <a
                  href={href(link.path)}
                  aria-current={isActive(pathname, link.path) ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </details>
    <button class="theme-toggle" type="button" aria-label="Switch to dark theme">Dark</button>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    height: var(--nav-h);
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    z-index: 40;
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 100%;
    padding: 0 6vw;
  }
  .brand {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 500;
    color: var(--fg);
    white-space: nowrap;
  }
  .nav-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    align-items: center;
  }
  .nav-links a {
    font-family: var(--font-serif);
    font-size: 16px;
    color: var(--fg-soft);
    padding: 6px 10px;
    transition: color 0.15s var(--ease);
  }
  .nav-links a:hover,
  .nav-links a:focus-visible {
    color: var(--accent);
  }
  .nav-links a[aria-current="page"] {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  .theme-toggle {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--fg-soft);
    background: transparent;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 3px 12px;
    cursor: pointer;
    flex-shrink: 0;
  }
  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* details/summary reset — on desktop it's always open; on mobile
     the summary acts as the hamburger toggle.
     ::details-content override is required: Chrome applies
     `content-visibility: hidden` to the ::details-content pseudo-element
     on a closed <details>, and `display:contents` on the host element
     does NOT defeat that hidden state — the pseudo-element sits between
     the host and its rendered children and Chrome's UA sheet wins.
     Overriding ::details-content directly forces the inner content
     visible at all times on desktop. Mobile hiding is handled separately
     by `.nav-links { display: none }` inside the ≤720px query, which
     is author CSS that Chrome does respect. */
  .nav-details {
    display: contents;
  }
  .nav-details::details-content {
    content-visibility: visible;
    display: contents;
  }
  .nav-details[open] .nav-links {
    display: flex;
  }

  /* Mobile menu toggle — hidden on desktop; summary element acts as it */
  .nav-toggle {
    display: none;
    list-style: none; /* remove default triangle from <summary> */
  }
  /* Remove WebKit default disclosure triangle */
  .nav-toggle::-webkit-details-marker {
    display: none;
  }

  @media (max-width: 720px) {
    .nav {
      flex-wrap: wrap;
      align-content: flex-start;
      padding: 0 4vw;
    }
    .brand {
      /* keep brand visible at top-left, constrain height to nav-h */
      line-height: var(--nav-h);
    }
    .nav-details {
      display: block; /* becomes a real positioned element on mobile */
      order: 3; /* after brand and toggle */
      margin-left: auto;
    }
    .nav-toggle {
      display: inline-flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 38px;
      height: 38px;
      background: transparent;
      border: 1px solid var(--line-strong);
      cursor: pointer;
    }
    .nav-toggle span {
      display: block;
      height: 2px;
      width: 18px;
      margin-inline: auto;
      background: var(--dim);
    }
    /* the toggle stays visible on mobile — it is the only way to change theme. */
    .theme-toggle {
      order: 2;
    }
    /* Default: links hidden; shown when details is open */
    .nav-links {
      flex-basis: 100%;
      flex-direction: column;
      gap: 0;
      display: none;
      border-top: 1px solid var(--line);
      padding-block: 8px;
      /* Position below the nav bar */
      position: absolute;
      top: var(--nav-h);
      left: 0;
      right: 0;
      background: var(--bg);
      z-index: 50;
    }
    .nav-details[open] .nav-links {
      display: flex;
    }
    .nav-links a {
      display: block;
      padding: 10px 4vw;
    }
  }
</style>

<script>
  import { applyTheme, nextTheme } from "../lib/theme";

  // Progressive enhancement: with JS, we keep the details element in sync with
  // aria-expanded for screen readers and for legacy JS that may query it.
  // Without JS, the native <details>/<summary> behaviour handles the toggle —
  // clicking the summary opens/closes the nav on mobile. No JS = no broken nav.
  const details = document.querySelector<HTMLDetailsElement>(".nav-details");
  const toggle = document.querySelector<HTMLElement>(".nav-toggle");

  if (details && toggle) {
    details.addEventListener("toggle", () => {
      toggle.setAttribute("aria-expanded", String(details.open));
    });
  }

  const themeToggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
  if (themeToggle) {
    // The label names the action, so it flips with the theme.
    const syncLabel = () => {
      const dark = document.documentElement.getAttribute("data-theme") === "dark";
      themeToggle.textContent = dark ? "Light" : "Dark";
      themeToggle.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
    };
    themeToggle.addEventListener("click", () => {
      applyTheme(nextTheme(document.documentElement.getAttribute("data-theme") ?? "light"));
      syncLabel();
    });
    syncLabel();
  }
</script>
