---
import { navLinks, href, isActive } from "../lib/links";
const pathname = Astro.url.pathname;
---

<header class="site-header">
  <nav class="nav" aria-label="Primary">
    <a class="brand" href={href("")}>
      <span class="brand-slash">~/</span>harish.dev
    </a>
    <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
      <span></span><span></span>
    </button>
    <ul class="nav-links">
      {
        navLinks.map((link) =>
          link.external ? (
            <li>
              <a href={link.path} target="_blank" rel="noopener noreferrer">
                {link.label}
              </a>
            </li>
          ) : (
            <li>
              <a
                href={href(link.path)}
                aria-current={isActive(pathname, link.path) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ),
        )
      }
    </ul>
    <button class="theme-dot" aria-label="Cycle theme"></button>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    height: var(--nav-h);
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    z-index: 40;
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 100%;
    padding: 0 6vw;
  }
  .brand {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--fg);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .brand-slash {
    color: var(--accent);
  }
  .nav-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    align-items: center;
  }
  .nav-links a {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg);
    opacity: 0.7;
    padding: 6px 10px;
    transition:
      color 0.15s var(--ease),
      opacity 0.15s var(--ease);
  }
  .nav-links a:hover,
  .nav-links a:focus-visible {
    opacity: 1;
    color: var(--accent);
  }
  .nav-links a[aria-current="page"] {
    opacity: 1;
    color: var(--accent);
  }

  /* Theme dot — wired in Task 6 */
  .theme-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1px solid var(--fg);
    background: var(--accent);
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
    transition: opacity 0.15s var(--ease);
  }
  .theme-dot:hover {
    opacity: 0.8;
  }

  /* Mobile menu toggle — hidden on desktop */
  .nav-toggle {
    display: none;
  }

  @media (max-width: 720px) {
    .nav {
      flex-wrap: wrap;
      align-content: flex-start;
      padding: 0 4vw;
    }
    .brand {
      /* keep brand visible at top-left, constrain height to nav-h */
      line-height: var(--nav-h);
    }
    .nav-toggle {
      display: inline-flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 38px;
      height: 38px;
      background: transparent;
      border: 1px solid var(--line);
      cursor: pointer;
      margin-left: auto;
    }
    .nav-toggle span {
      display: block;
      height: 2px;
      width: 18px;
      margin-inline: auto;
      background: var(--dim);
    }
    /* hide theme-dot on mobile to keep nav uncluttered */
    .theme-dot {
      display: none;
    }
    .nav-links {
      flex-basis: 100%;
      flex-direction: column;
      gap: 0;
      display: none;
      border-top: 1px solid var(--line);
      padding-block: 8px;
    }
    .nav-links.open {
      display: flex;
    }
    .nav-links a {
      display: block;
      padding: 10px 4vw;
    }
  }
</style>

<script>
  // Progressive enhancement: the menu toggle. Without JS, the nav
  // links render inline (no toggle needed on desktop); on mobile the
  // toggle simply reveals the already-present list. Content is never
  // hidden from crawlers or no-JS users on desktop widths.
  const toggle = document.querySelector(".nav-toggle");
  const links = document.querySelector(".nav-links");
  toggle?.addEventListener("click", () => {
    const open = links?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", String(Boolean(open)));
  });
</script>
