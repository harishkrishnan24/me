---
// GlyphField — animated ASCII glyph canvas for the terminal-editorial design.
// Reused on the home page (interactive, full-bleed hero) and Task 4 page bands
// (non-interactive, fixed height).
//
// Props
//   density   – cell size in CSS px; controls how dense the grid is (home: ~20,
//               page bands: ~26)
//   interactive – whether the canvas reacts to the cursor position
//   height    – CSS height for the outer container div (e.g. "100%", "260px")
//
// Requirements
//   • Reads --fg and --accent via getComputedStyle so it follows the active theme.
//   • Re-reads colors on a "themechange" CustomEvent (dispatched by Task 6).
//   • Caps devicePixelRatio at 1.5.
//   • Honours prefers-reduced-motion: renders ONE static frame only.
//   • aria-hidden="true" — purely decorative.
//   • Cleans up RAF, pointermove, and resize listeners when removed from the DOM.
//   • Multiple instances coexist — no document-level singleton.
interface Props {
  density?: number;
  interactive?: boolean;
  height?: string;
}
const {
  density = 20,
  interactive = false,
  height = "100%",
} = Astro.props;

// Unique DOM id so each instance's inline script targets only its own canvas.
const uid = `gf-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="glyph-field" id={uid} style={`height:${height}`}>
  <canvas aria-hidden="true"></canvas>
</div>

<!-- define:vars opts this script out of bundling; each instance runs its own copy. -->
<script define:vars={{ uid, density, interactive }}>
(function () {
  // Glyph set from the design spec.
  const GLYPHS = "01<>/\\{}[]()=+-*#$&%@_|~^";
  const DPR = Math.min(window.devicePixelRatio || 1, 1.5);
  const reducedMotion =
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function run() {
    const root = document.getElementById(uid);
    if (!root) return;

    const canvas = /** @type {HTMLCanvasElement} */ (root.querySelector("canvas"));
    if (!canvas) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    let cols = 0;
    let rows = 0;
    let t = 0;
    let raf = null;
    // Pointer in viewport CSS-px space (default: far off-screen).
    let mx = -9999;
    let my = -9999;
    // Resolved color values.
    let fgColor = "#edeae3";
    let accentColor = "oklch(0.8 0.15 145)";

    function readColors() {
      const s = getComputedStyle(document.documentElement);
      const fg = s.getPropertyValue("--fg").trim();
      const ac = s.getPropertyValue("--accent").trim();
      if (fg) fgColor = fg;
      if (ac) accentColor = ac;
    }
    readColors();

    // ── Sizing ─────────────────────────────────────────────────────────────
    function resize() {
      const w = root.clientWidth;
      const h = root.clientHeight;
      if (!w || !h) return;
      canvas.width = Math.round(w * DPR);
      canvas.height = Math.round(h * DPR);
      canvas.style.width = w + "px";
      canvas.style.height = h + "px";
      cols = Math.floor(w / density);
      rows = Math.floor(h / density);
    }

    // ── Draw one frame ──────────────────────────────────────────────────────
    function draw() {
      const W = canvas.width;
      const H = canvas.height;
      ctx.clearRect(0, 0, W, H);

      // Physical cell size (canvas px = CSS px × DPR).
      const physCell = density * DPR;
      const fontSize = Math.round(physCell * 0.72);
      ctx.font = `${fontSize}px 'JetBrains Mono', monospace`;
      ctx.textBaseline = "top";

      // Only compute bounding rect once per frame (and only when interactive).
      const rect = interactive ? canvas.getBoundingClientRect() : null;

      for (let i = 0; i < cols; i++) {
        for (let j = 0; j < rows; j++) {
          // ── Algorithm from the design spec ──────────────────────────────
          const n =
            Math.sin(i * 0.19 + t) * Math.cos(j * 0.23 - t * 0.8) +
            Math.sin((i + j) * 0.07 + t * 1.4);
          let v = (n + 2) / 4;

          // Cursor proximity influence (interactive only).
          let near = 0;
          if (interactive && rect) {
            // Cell centre in viewport CSS-px coordinates.
            const cx = rect.left + (i + 0.5) * density;
            const cy = rect.top + (j + 0.5) * density;
            const d = Math.hypot(mx - cx, my - cy);
            if (d < 260) {
              near = 1 - d / 260;
              v = v * 0.55 + near * 1.1;
            }
          }

          if (v < 0.34) continue;

          // Glyph index from spec.
          const gi =
            (i * 7 + j * 13 + Math.floor(t * 3 + v * 9)) % GLYPHS.length;

          const x = i * physCell;
          const y = j * physCell;

          if (near > 0.42) {
            // Hot cell — accent colour, high alpha.
            ctx.globalAlpha = 0.95;
            ctx.fillStyle = accentColor;
          } else {
            // 5 alpha buckets over the visible v range [0.34, 1.0].
            // Bucket width = (1.0 - 0.34) / 5 = 0.132.
            const k = Math.min(
              4,
              Math.floor((v - 0.34) / 0.132)
            );
            ctx.globalAlpha = 0.05 + k * 0.055;
            ctx.fillStyle = fgColor;
          }

          ctx.fillText(GLYPHS[gi], x, y);
        }
      }

      ctx.globalAlpha = 1;
    }

    // ── Animation loop ──────────────────────────────────────────────────────
    function frame() {
      draw();
      if (!reducedMotion) {
        t += 0.012;
        raf = requestAnimationFrame(frame);
      }
      // reduced-motion: one static frame drawn above, loop stops here.
    }

    // ── Event listeners ─────────────────────────────────────────────────────
    function onMove(e) {
      mx = e.clientX;
      my = e.clientY;
    }
    function onResize() {
      resize();
      if (reducedMotion) draw();
    }
    function onTheme() {
      readColors();
      if (reducedMotion) draw();
    }

    // ── Init ────────────────────────────────────────────────────────────────
    resize();
    frame();

    if (interactive) window.addEventListener("pointermove", onMove);
    window.addEventListener("resize", onResize);
    window.addEventListener("themechange", onTheme);

    // ── Cleanup when this element is removed from the DOM ───────────────────
    const mo = new MutationObserver(function () {
      if (!document.contains(root)) {
        if (raf !== null) cancelAnimationFrame(raf);
        if (interactive) window.removeEventListener("pointermove", onMove);
        window.removeEventListener("resize", onResize);
        window.removeEventListener("themechange", onTheme);
        mo.disconnect();
      }
    });
    mo.observe(document.body, { childList: true, subtree: true });
  }

  // Defer until DOM is ready (inline scripts run as they're parsed).
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", run);
  } else {
    run();
  }
})();
</script>

<style>
  .glyph-field {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .glyph-field canvas {
    position: absolute;
    inset: 0;
    display: block;
    /* The canvas covers the container; CSS width/height are set by JS
       after each resize to keep pixel ↔ CSS-px consistent. */
  }
</style>
