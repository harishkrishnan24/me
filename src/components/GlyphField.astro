---
// GlyphField — animated ASCII glyph canvas for the terminal-editorial design.
// Reused on the home page (interactive, full-bleed hero) and Task 4 page bands
// (non-interactive, fixed height).
//
// Props
//   density   – cell size in CSS px; controls how dense the grid is (home: ~20,
//               page bands: ~26)
//   interactive – whether the canvas reacts to the cursor position
//   height    – CSS height for the outer container div (e.g. "100%", "260px")
//
// Requirements
//   • Reads --fg and --accent via getComputedStyle so it follows the active theme.
//   • Re-reads colors on a "themechange" CustomEvent (dispatched by Task 6).
//   • Caps devicePixelRatio at 1.5.
//   • Honours prefers-reduced-motion: renders ONE static frame only.
//   • aria-hidden="true" — purely decorative.
//   • Cleans up RAF, pointermove, and resize listeners when removed from the DOM.
//   • Multiple instances coexist — no document-level singleton.
interface Props {
  density?: number;
  interactive?: boolean;
  height?: string;
}
const {
  density = 20,
  interactive = false,
  height = "100%",
} = Astro.props;

// Unique DOM id so each instance's inline script targets only its own canvas.
const uid = `gf-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="glyph-field" id={uid} style={`height:${height}`}>
  <canvas aria-hidden="true"></canvas>
</div>

<!-- define:vars opts this script out of bundling; each instance runs its own copy. -->
<script define:vars={{ uid, density, interactive }}>
(function () {
  // Glyph set from the design spec.
  const GLYPHS = "01<>/\\{}[]()=+-*#$&%@_|~^";
  const DPR = Math.min(window.devicePixelRatio || 1, 1.5);
  const reducedMotion =
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function run() {
    const root = document.getElementById(uid);
    if (!root) return;

    const canvas = /** @type {HTMLCanvasElement} */ (root.querySelector("canvas"));
    if (!canvas) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    let cols = 0;
    let rows = 0;
    let t = 0;
    let raf = null;
    // Pointer in viewport CSS-px space (default: far off-screen).
    let mx = -9999;
    let my = -9999;
    // Resolved color values.
    let fgColor = "#edeae3";
    let accentColor = "oklch(0.8 0.15 145)";

    function readColors() {
      const s = getComputedStyle(document.documentElement);
      const fg = s.getPropertyValue("--fg").trim();
      const ac = s.getPropertyValue("--accent").trim();
      if (fg) fgColor = fg;
      if (ac) accentColor = ac;
    }
    readColors();

    // ── Sizing ─────────────────────────────────────────────────────────────
    function resize() {
      const w = root.clientWidth;
      const h = root.clientHeight;
      if (!w || !h) return;
      canvas.width = Math.round(w * DPR);
      canvas.height = Math.round(h * DPR);
      canvas.style.width = w + "px";
      canvas.style.height = h + "px";
      cols = Math.floor(w / density);
      rows = Math.floor(h / density);
    }

    // ── Draw one frame ──────────────────────────────────────────────────────
    function draw() {
      const W = canvas.width;
      const H = canvas.height;
      ctx.clearRect(0, 0, W, H);

      // Physical cell size (canvas px = CSS px × DPR).
      const physCell = density * DPR;
      const fontSize = Math.round(physCell * 0.72);
      ctx.font = `${fontSize}px 'JetBrains Mono', monospace`;
      ctx.textBaseline = "top";

      // Only compute bounding rect once per frame (and only when interactive).
      const rect = interactive ? canvas.getBoundingClientRect() : null;

      // The cursor halo is a HOVER effect: it lights up only while the pointer
      // is actually over the field. pointermove is bound to the window (so the
      // position is still tracked when the pointer is over the hero copy, which
      // sits above the canvas), which means the halo would otherwise follow the
      // cursor across the nav bar and into the sections below — anywhere within
      // 260px of a cell. Gate on the bounds instead of the event target: it is
      // immune to whatever is stacked on top of the canvas, and the rect is
      // already computed above, so it costs nothing.
      const hovering =
        rect !== null &&
        mx >= rect.left &&
        mx <= rect.right &&
        my >= rect.top &&
        my <= rect.bottom;

      for (let i = 0; i < cols; i++) {
        for (let j = 0; j < rows; j++) {
          // ── Algorithm from the design spec ──────────────────────────────
          const n =
            Math.sin(i * 0.19 + t) * Math.cos(j * 0.23 - t * 0.8) +
            Math.sin((i + j) * 0.07 + t * 1.4);
          let v = (n + 2) / 4;

          // Cursor proximity influence (only while hovering the field).
          let near = 0;
          if (hovering && rect) {
            // Cell centre in viewport CSS-px coordinates.
            const cx = rect.left + (i + 0.5) * density;
            const cy = rect.top + (j + 0.5) * density;
            const d = Math.hypot(mx - cx, my - cy);
            if (d < 260) {
              near = 1 - d / 260;
              v = v * 0.55 + near * 1.1;
            }
          }

          if (v < 0.34) continue;

          // Glyph index from spec.
          const gi =
            (i * 7 + j * 13 + Math.floor(t * 3 + v * 9)) % GLYPHS.length;

          const x = i * physCell;
          const y = j * physCell;

          if (near > 0.42) {
            // Hot cell — accent colour, high alpha.
            ctx.globalAlpha = 0.95;
            ctx.fillStyle = accentColor;
          } else {
            // 5 alpha buckets over the visible v range [0.34, 1.0].
            // Bucket width = (1.0 - 0.34) / 5 = 0.132.
            const k = Math.min(
              4,
              Math.floor((v - 0.34) / 0.132)
            );
            ctx.globalAlpha = 0.05 + k * 0.055;
            ctx.fillStyle = fgColor;
          }

          ctx.fillText(GLYPHS[gi], x, y);
        }
      }

      ctx.globalAlpha = 1;
    }

    // ── Animation loop ──────────────────────────────────────────────────────
    let running = false;

    function frame() {
      draw();
      if (!reducedMotion && running) {
        t += 0.012;
        raf = requestAnimationFrame(frame);
      }
      // reduced-motion: one static frame drawn above, loop stops here.
    }

    function start() {
      if (running || reducedMotion) return;
      running = true;
      raf = requestAnimationFrame(frame);
    }

    function stop() {
      running = false;
      if (raf !== null) {
        cancelAnimationFrame(raf);
        raf = null;
      }
    }

    // ── Event listeners ─────────────────────────────────────────────────────
    function onMove(e) {
      mx = e.clientX;
      my = e.clientY;
    }
    // Park the pointer off-canvas when it leaves the window, otherwise a last
    // known position inside the bounds leaves the halo frozen mid-field.
    function onPointerOut(e) {
      if (!e.relatedTarget) {
        mx = -9999;
        my = -9999;
      }
    }
    function onResize() {
      resize();
      if (reducedMotion) draw();
    }
    function onTheme() {
      readColors();
      if (reducedMotion) draw();
    }

    // ── Init ────────────────────────────────────────────────────────────────
    resize();
    // Always paint one frame. For reduced-motion visitors this is the only
    // frame they ever get, so it must not depend on the loop starting.
    draw();

    if (interactive) {
      window.addEventListener("pointermove", onMove);
      document.addEventListener("pointerout", onPointerOut);
    }
    window.addEventListener("resize", onResize);
    window.addEventListener("themechange", onTheme);

    // ── Run only while on screen ────────────────────────────────────────────
    // A frame repaints on the order of 1500 glyphs. requestAnimationFrame
    // throttles in a BACKGROUND TAB but not in a visible tab that has simply
    // scrolled past the canvas — so without this the hero keeps animating for
    // the whole length of an article. rootMargin starts it just before it
    // scrolls back into view, so there is no visible cold start.
    // Start unconditionally, then let the observer correct it on its first
    // callback (which arrives within a frame or two). Gating the initial start
    // on the observer would make the whole effect depend on it firing — and it
    // does NOT fire while the document is hidden, so a page opened in a
    // background tab would have a permanently frozen canvas. This way the
    // observer is purely an optimisation: worst case it never runs and we are
    // back to the previous always-on behaviour.
    start();

    const io = new IntersectionObserver(
      function (entries) {
        if (entries[entries.length - 1].isIntersecting) start();
        else stop();
      },
      { rootMargin: "128px" },
    );
    io.observe(root);

    // No teardown hook: this is a static multi-page site, so a navigation is a
    // full document unload and the browser discards all of this. If client-side
    // view transitions are ever added, the listeners above and this observer
    // will need explicit cleanup — there is no longer a MutationObserver
    // watching for removal (it fired on every unrelated DOM mutation, including
    // every line appended to the terminal, to detect something that never
    // happens here).
  }

  // Defer until DOM is ready (inline scripts run as they're parsed).
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", run);
  } else {
    run();
  }
})();
</script>

<style>
  .glyph-field {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .glyph-field canvas {
    position: absolute;
    inset: 0;
    display: block;
    /* The canvas covers the container; CSS width/height are set by JS
       after each resize to keep pixel ↔ CSS-px consistent. */
  }
</style>
