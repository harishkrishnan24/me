---
// CommandDeck — owns one keydown listener for ⌘K, backtick, T, Escape, and
// the Konami sequence. Mounts two overlays: a command palette and a terminal.
//
// Justification for one component: a single keydown listener must own all
// five bindings. Splitting palette and terminal means two scripts competing
// for the same events and duplicated Escape handling.
//
// With JS disabled this renders hidden and inert — nothing appears and nothing
// breaks. Every navigation <a href> is resolved through href() so the palette
// is crawlable and works even if scripting half-loads.

import { href } from "../lib/links";

// Palette rows — every navigation entry is a real anchor so crawlers and
// no-JS visitors can reach them. Hint text is secondary metadata.
const paletteRows = [
  { label: "Home", hint: "~/", path: "" },
  { label: "About", hint: "who I am", path: "about" },
  { label: "Projects", hint: "what I've built", path: "projects" },
  { label: "Writing", hint: "posts & essays", path: "blog" },
  { label: "Open Source", hint: "OSS contributions", path: "opensource" },
];
---

<!-- The entire deck is hidden; JS makes it visible when triggered. -->
<div id="command-deck" aria-hidden="true" inert>
  <!-- ── COMMAND PALETTE ────────────────────────────────────────────────── -->
  <div id="palette-overlay" class="overlay palette-overlay" role="dialog" aria-modal="true" aria-label="Command palette">
    <div class="palette-sheet">
      <div class="palette-header">
        <input
          id="palette-input"
          class="palette-input"
          type="text"
          placeholder="Search…"
          autocomplete="off"
          spellcheck="false"
        />
        <kbd class="palette-esc">esc</kbd>
      </div>
      <ul class="palette-list" id="palette-list">
        {paletteRows.map((row) => (
          <li class="palette-item" data-label={row.label.toLowerCase()} data-hint={row.hint.toLowerCase()}>
            <a class="palette-row" href={href(row.path)}>
              <span class="palette-label">{row.label}</span>
              <span class="palette-hint">{row.hint}</span>
            </a>
          </li>
        ))}
        {/* Action row, not navigation. This is the keyboard route to theme
            switching: the bare `T` shortcut was removed because single-character
            shortcuts collide with screen-reader browse mode (in NVDA/JAWS `t`
            jumps to the next table) and fail WCAG 2.1.4. ⌘K is modifier-guarded,
            so reaching it through the palette is safe. */}
        <li class="palette-item" data-label="cycle theme" data-hint="dark light crt">
          <button class="palette-row" type="button" id="palette-theme">
            <span class="palette-label">Cycle theme</span>
            <span class="palette-hint">dark / light / crt</span>
          </button>
        </li>
      </ul>
    </div>
  </div>

  <!-- ── TERMINAL ───────────────────────────────────────────────────────── -->
  <div id="terminal-overlay" class="overlay terminal-overlay" role="dialog" aria-modal="true" aria-label="Terminal">
    <div class="terminal-sheet">
      <div class="terminal-log" id="terminal-log" aria-live="polite" aria-label="Terminal output"></div>
      <div class="terminal-prompt-row">
        <span class="terminal-ps1">harish@dev:~$</span>
        <input
          id="terminal-input"
          class="terminal-input"
          type="text"
          autocomplete="off"
          spellcheck="false"
          aria-label="Terminal input"
        />
        <span class="terminal-caret" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</div>

<script>
  import { nextTheme, applyTheme } from "../lib/theme";
  import { runCommand } from "../lib/terminal-commands";
  import { href } from "../lib/links";

  // ── DOM refs ──────────────────────────────────────────────────────────────
  const deck = document.getElementById("command-deck")!;
  const paletteOverlay = document.getElementById("palette-overlay")!;
  const paletteInput = document.getElementById("palette-input") as HTMLInputElement;
  const paletteList = document.getElementById("palette-list")!;
  const terminalOverlay = document.getElementById("terminal-overlay")!;
  const terminalInput = document.getElementById("terminal-input") as HTMLInputElement;
  const terminalLog = document.getElementById("terminal-log")!;

  // ── State ─────────────────────────────────────────────────────────────────
  let paletteOpen = false;
  let terminalOpen = false;
  // Captures focus before an overlay opens so we can restore it on close.
  let focusReturnTarget: HTMLElement | null = null;
  // Tracks siblings we added inert to, so we only remove what we set.
  let inertedSiblings: Element[] = [];

  // ── Helpers ───────────────────────────────────────────────────────────────
  function isTyping(): boolean {
    const tag = (document.activeElement?.tagName ?? "").toLowerCase();
    const ce = (document.activeElement as HTMLElement | null)?.isContentEditable;
    return tag === "input" || tag === "textarea" || !!ce;
  }

  // Apply inert to every top-level body sibling of #command-deck that isn't
  // already inert — making aria-modal="true" truthful for screen readers.
  function trapSiblings() {
    const siblings = Array.from(document.body.children).filter(el => el !== deck);
    inertedSiblings = siblings.filter(el => !el.hasAttribute("inert"));
    inertedSiblings.forEach(el => el.setAttribute("inert", ""));
  }

  // Remove inert only from elements we added it to — never clobber pre-existing inert.
  function releaseSiblings() {
    inertedSiblings.forEach(el => el.removeAttribute("inert"));
    inertedSiblings = [];
  }

  function openPalette() {
    focusReturnTarget = document.activeElement as HTMLElement | null;
    paletteOpen = true;
    deck.removeAttribute("aria-hidden");
    deck.removeAttribute("inert");
    if (!terminalOpen) trapSiblings();
    paletteOverlay.classList.add("visible");
    paletteInput.value = "";
    filterPalette("");
    paletteInput.focus();
  }

  function closePalette() {
    paletteOpen = false;
    paletteOverlay.classList.remove("visible");
    if (!terminalOpen) {
      deck.setAttribute("aria-hidden", "true");
      deck.setAttribute("inert", "");
      releaseSiblings();
    }
    paletteInput.blur();
    focusReturnTarget?.focus?.();
    focusReturnTarget = null;
  }

  function openTerminal() {
    focusReturnTarget = document.activeElement as HTMLElement | null;
    terminalOpen = true;
    deck.removeAttribute("aria-hidden");
    deck.removeAttribute("inert");
    if (!paletteOpen) trapSiblings();
    terminalOverlay.classList.add("visible");
    terminalInput.value = "";
    terminalInput.focus();
  }

  function closeTerminal() {
    terminalOpen = false;
    terminalOverlay.classList.remove("visible");
    if (!paletteOpen) {
      deck.setAttribute("aria-hidden", "true");
      deck.setAttribute("inert", "");
      releaseSiblings();
    }
    terminalInput.blur();
    focusReturnTarget?.focus?.();
    focusReturnTarget = null;
  }

  function closeAll() {
    // Save target and null it out before calling individual closers —
    // if only one overlay is open, the other closer must not fire a
    // focus-restore attempt against an element that is still inert.
    // Restoring once here, after all inert is released, is correct.
    const target = focusReturnTarget;
    focusReturnTarget = null;

    if (paletteOpen) {
      paletteOpen = false;
      paletteOverlay.classList.remove("visible");
      paletteInput.blur();
    }
    if (terminalOpen) {
      terminalOpen = false;
      terminalOverlay.classList.remove("visible");
      terminalInput.blur();
    }
    deck.setAttribute("aria-hidden", "true");
    deck.setAttribute("inert", "");
    releaseSiblings();
    target?.focus?.();
  }

  // ── Palette filtering ─────────────────────────────────────────────────────
  function filterPalette(query: string) {
    const q = query.toLowerCase().trim();
    const items = paletteList.querySelectorAll<HTMLLIElement>(".palette-item");
    items.forEach((item) => {
      const label = item.dataset.label ?? "";
      const hint = item.dataset.hint ?? "";
      const matches = !q || label.includes(q) || hint.includes(q);
      item.style.display = matches ? "" : "none";
    });
  }

  // ── Terminal output ───────────────────────────────────────────────────────
  function appendLines(lines: string[]) {
    lines.forEach((line) => {
      const p = document.createElement("p");
      p.className = "terminal-line";
      p.textContent = line;
      terminalLog.appendChild(p);
    });
    terminalLog.scrollTop = terminalLog.scrollHeight;
  }

  function clearLog() {
    terminalLog.innerHTML = "";
  }

  // ── Theme controls ────────────────────────────────────────────────────────
  // Two affordances, both explicit: the nav dot (pointer) and a palette row
  // (keyboard, behind the modifier-guarded ⌘K). There is deliberately no bare
  // `T` shortcut — see the keydown listener.
  function cycleTheme() {
    const current = document.documentElement.getAttribute("data-theme") ?? "dark";
    applyTheme(nextTheme(current));
  }

  document
    .querySelector<HTMLButtonElement>(".theme-dot")
    ?.addEventListener("click", cycleTheme);

  document
    .querySelector<HTMLButtonElement>("#palette-theme")
    ?.addEventListener("click", () => {
      cycleTheme();
      closePalette();
    });

  // ── Konami sequence ───────────────────────────────────────────────────────
  // NOTE: the konami tracker runs BEFORE the isTyping() guard below, so typing
  // the sequence inside the palette or terminal input intentionally triggers the
  // glitch. This is a feature of the easter egg — do not "fix" it by moving the
  // tracker after the isTyping() check.
  const KONAMI = [
    "ArrowUp", "ArrowUp", "ArrowDown", "ArrowDown",
    "ArrowLeft", "ArrowRight", "ArrowLeft", "ArrowRight",
    "b", "a",
  ];
  let konamiIdx = 0;

  // ── Single keydown listener ───────────────────────────────────────────────
  window.addEventListener("keydown", (e: KeyboardEvent) => {
    // Konami — track regardless of context
    if (e.key === KONAMI[konamiIdx]) {
      konamiIdx++;
      if (konamiIdx === KONAMI.length) {
        konamiIdx = 0;
        document.documentElement.setAttribute("data-glitch", "1");
        setTimeout(() => document.documentElement.removeAttribute("data-glitch"), 1200);
      }
    } else {
      konamiIdx = 0;
    }

    // Escape — close whatever is open
    if (e.key === "Escape") {
      closeAll();
      return;
    }

    // ⌘K / Ctrl+K — open palette (fires even while typing, like real palette apps)
    if (e.key === "k" && (e.metaKey || e.ctrlKey)) {
      e.preventDefault();
      if (paletteOpen) {
        closePalette();
      } else {
        closeTerminal(); // ensure terminal is closed before opening palette
        openPalette();
      }
      return;
    }

    // The bindings below must NOT fire while in an input/textarea
    if (isTyping()) return;

    // Backtick — open terminal
    if (e.key === "`") {
      e.preventDefault();
      if (terminalOpen) {
        closeTerminal();
      } else {
        openTerminal();
      }
      return;
    }

    // No bare `T` theme shortcut. A single-character shortcut with no modifier
    // fails WCAG 2.1.4 (Character Key Shortcuts) and collides with screen-reader
    // browse mode, where NVDA and JAWS bind `t` to "jump to next table" — a
    // reader tabbing through tables on /about would have repainted the whole
    // site under themselves. Theme switching lives on the nav dot and on a
    // palette row instead, both reachable and neither a lone letter.
  });

  // ── Palette input filtering ───────────────────────────────────────────────
  paletteInput.addEventListener("input", () => {
    filterPalette(paletteInput.value);
  });

  // ── Terminal input submission ─────────────────────────────────────────────
  terminalInput.addEventListener("keydown", (e: KeyboardEvent) => {
    if (e.key === "Enter") {
      e.preventDefault();
      const input = terminalInput.value;
      terminalInput.value = "";

      const result = runCommand(input, document.documentElement.getAttribute("data-theme") ?? "dark");

      if (result.clear) {
        clearLog();
        return;
      }

      appendLines(result.lines);

      if (result.route !== undefined) {
        // Navigate after a short delay so the user can see the echo line
        setTimeout(() => {
          window.location.href = href(result.route!);
        }, 300);
      }
    }
  });

  // ── Click outside to close ────────────────────────────────────────────────
  paletteOverlay.addEventListener("click", (e) => {
    if (e.target === paletteOverlay) closePalette();
  });
  terminalOverlay.addEventListener("click", (e) => {
    if (e.target === terminalOverlay) closeTerminal();
  });
</script>

<style>
  /* ── OVERLAY BASE ────────────────────────────────────────────────────────── */
  .overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 200;
    /* Hidden unless .visible — content invisible and non-interactive without JS */
  }
  .overlay.visible {
    display: flex;
  }

  /* ── COMMAND PALETTE ─────────────────────────────────────────────────────── */
  .palette-overlay {
    align-items: flex-start;
    justify-content: center;
    padding-top: 18vh;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
  }

  .palette-sheet {
    width: min(560px, calc(100vw - 32px));
    background: var(--panel);
    border: 1px solid var(--line);
    overflow: hidden;
  }

  .palette-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line-strong);
  }

  .palette-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--fg);
    caret-color: var(--accent);
  }
  .palette-input::placeholder {
    color: var(--dim);
  }

  .palette-esc {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--dim);
    border: 1px solid var(--line);
    padding: 2px 6px;
    letter-spacing: 0.05em;
  }

  .palette-list {
    list-style: none;
    max-height: 320px;
    overflow-y: auto;
  }

  .palette-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 16px;
    color: var(--fg);
    transition: background 0.1s var(--ease);
    /* The theme row is a <button>, the rest are <a>. Normalise so the two
       render identically inside the list. */
    width: 100%;
    background: none;
    border: 0;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .palette-row:hover,
  .palette-row:focus-visible {
    background: var(--line);
    outline: none;
  }

  .palette-label {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--fg);
  }

  .palette-hint {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--dim);
  }

  /* ── TERMINAL ────────────────────────────────────────────────────────────── */
  .terminal-overlay {
    align-items: flex-end;
    background: transparent;
    pointer-events: none; /* only the sheet is interactive */
  }

  .terminal-sheet {
    width: 100%;
    height: 44vh;
    background: var(--panel);
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    pointer-events: all;
  }

  .terminal-log {
    flex: 1;
    overflow-y: auto;
    padding: 14px 20px 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .terminal-line {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--fg);
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-all;
  }

  .terminal-prompt-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-top: 1px solid var(--line-strong);
    background: var(--bg);
  }

  .terminal-ps1 {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .terminal-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--fg);
    caret-color: transparent; /* we show a custom caret below */
  }

  /* Blinking accent caret */
  .terminal-caret {
    display: inline-block;
    width: 8px;
    height: 14px;
    background: var(--accent);
    flex-shrink: 0;
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* ── GLITCH ──────────────────────────────────────────────────────────────── */
  /* Triggered by the Konami sequence: sets data-glitch="1" on <html> for 1200ms */
  :global(html[data-glitch="1"]) :global(body) {
    animation: glitch 0.15s steps(2) 8;
  }

  @keyframes glitch {
    0%   { transform: translate(0, 0); filter: none; }
    25%  { transform: translate(-3px, 2px); filter: hue-rotate(90deg) saturate(3); }
    50%  { transform: translate(3px, -2px); filter: invert(0.15) hue-rotate(180deg); }
    75%  { transform: translate(-2px, -2px); filter: hue-rotate(270deg); }
    100% { transform: translate(0, 0); filter: none; }
  }
</style>
